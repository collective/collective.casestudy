<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="collective.casestudy"
    >

  <configure zcml:condition="installed AccessControl.security">

    <permission
        id="collective.casestudy.casestudy.add"
        title="collective.casestudy: Add Case Study"
        />

    <permission
        id="collective.casestudy.organization.add"
        title="collective.casestudy: Add Organization"
        />

    <!-- Provider Information behavior -->
    <permission
        id="collective.casestudy.provider_info.edit"
        title="collective.casestudy: Edit Provider Information"
        />

    <permission
        id="collective.casestudy.provider_info.view"
        title="collective.casestudy: View Provider Information"
        />

    <permission
        id="collective.casestudy.provider_info.manage"
        title="collective.casestudy: Manage Provider Listing"
        />

    <!-- Contact Information behavior -->
    <permission
        id="collective.casestudy.contact_info.view"
        title="collective.casestudy: View Contact Information"
        />
    <permission
        id="collective.casestudy.contact_info.edit"
        title="collective.casestudy: Edit Contact Information"
        />

    <!-- Organization Information behavior -->
    <permission
        id="collective.casestudy.organization_info.edit"
        title="collective.casestudy: Edit Organization Information"
        />
    <permission
        id="collective.casestudy.organization_info.view"
        title="collective.casestudy: View Organization Information"
        />

  </configure>

</configure>
