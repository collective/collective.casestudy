<configure xmlns="http://namespaces.zope.org/zope">

  <!-- CaseStudy -->
  <subscriber
      for="collective.casestudy.content.case_study.ICaseStudy
           zope.lifecycleevent.IObjectAddedEvent"
      handler=".case_study.added"
      />

  <subscriber
      for="collective.casestudy.content.case_study.ICaseStudy
           zope.lifecycleevent.IObjectModifiedEvent"
      handler=".case_study.modified"
      />

  <!-- Organization -->
  <subscriber
      for="collective.casestudy.content.organization.IOrganization
           zope.lifecycleevent.IObjectAddedEvent"
      handler=".organization.added"
      />

  <subscriber
      for="collective.casestudy.content.organization.IOrganization
           zope.lifecycleevent.IObjectModifiedEvent"
      handler=".organization.modified"
      />

</configure>
