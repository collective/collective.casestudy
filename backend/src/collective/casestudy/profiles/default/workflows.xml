<?xml version="1.0" encoding="utf-8"?>
<object meta_type="Plone Workflow Tool"
        name="portal_workflow"
>
  <!-- The provider workflow is only defined here. It is never bound to a
       type: the chain adapter appends it for content providing the behavior
       marker. -->
  <object meta_type="Workflow"
          name="provider_workflow"
  />
  <object meta_type="Workflow"
          name="casestudy_workflow"
  />
  <bindings>
    <type type_id="CaseStudy">
      <bound-workflow workflow_id="casestudy_workflow" />
    </type>
  </bindings>
</object>
